# ---------------------------------------------------------------------------
# CodeAndGo — variables d'environnement
# Copiez ce fichier en `.env` puis renseignez les valeurs réelles.
# `.env` est ignoré par Git : aucun secret ne doit être committé.
# ---------------------------------------------------------------------------

# URL canonique du site (utilisée pour les métadonnées, le sitemap et l'OG).
NEXT_PUBLIC_SITE_URL=https://www.codeandgo.fr

# --- Envoi des demandes de devis et des messages de contact (SMTP Gmail) ----
#
# Sans ces variables, /api/devis et /api/contact répondent une erreur explicite
# au visiteur : aucun faux succès n'est jamais simulé.
#
# SMTP_PASSWORD n'est PAS le mot de passe du compte Google : Gmail bloque
# l'authentification SMTP par mot de passe depuis 2022. Il faut un « mot de
# passe d'application » de 16 caractères, créé sur
# https://myaccount.google.com/apppasswords (la validation en deux étapes doit
# être active pour que cette page existe).
SMTP_HOST="smtp.gmail.com"
# SMTP_PORT et SMTP_SECURE vont par paire : 587 + false, ou 465 + true.
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="codeandgocontact@gmail.com"
SMTP_PASSWORD=""

# Destinataires des formulaires — FACULTATIF.
# Par défaut, les adresses déclarées dans `site.contact.notify`
# (src/data/site.ts). Plusieurs adresses : séparez-les par une virgule.
ADMIN_EMAIL="codeandgocontact@gmail.com,adam.mekkiou@outlook.fr"
